# ============================================================
# MuPGA Web — Variables de entorno
# Copiar a .env y completar con los valores reales.
# NUNCA commitear el .env con credenciales reales.
# ============================================================

# ── Base de datos SQL Server ──────────────────────────────────
# Instancia nombrada: incluir el nombre en DB_HOST (ej. localhost\SQLEXPRESS01).
# DB_PORT: dejar vacío para que SQL Server Browser resuelva automáticamente.
# Si Browser no corre y querés puerto fijo: SQL Server Config Manager
# → Protocols for SQLEXPRESS01 → TCP/IP → IP Addresses → IPAll → TCP Port.
DB_HOST=localhost\SQLEXPRESS01
DB_PORT=
DB_NAME=MuOnline
DB_USER=sa
DB_PASS=

# true  → usa [dbo].[fn_md5](password, username) — mismo método que el GameServer
# false → contraseña en texto plano (no recomendado)
DB_USE_MD5=true

# ── Autenticación ─────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT.
# MIGRACIÓN: Generar en el VPS con: php -r "echo bin2hex(random_bytes(32));"
# Mínimo 32 caracteres. Cambiarla invalida todos los tokens activos.
APP_SECRET=

# ── CORS (cross-origin para Cloudflare Pages → VPS) ──────────
# MIGRACIÓN: Agregar los dominios de Cloudflare Pages separados por coma.
# Ejemplo: https://mupga.pages.dev,https://mupga.com
# En local no hace falta — localhost está permitido por defecto.
CORS_ALLOWED_ORIGINS=

# ── Donaciones / Tienda WCoin ─────────────────────────────────
# URL base de la API externa de pagos (sin barra final).
# Usada por el proxy PHP (api/donate/order.php) para reenviar órdenes.
# Ejemplo desarrollo: http://localhost:5000
# Ejemplo producción: https://pagos-api.mupga.com.ar
PAYMENTS_API_URL=http://localhost:5000

# Clave compartida con el VPS de pagos (.NET) para firmar/verificar el JWT de órdenes.
# Generar con: php -r "echo bin2hex(random_bytes(32));"
# Debe coincidir exactamente con jwtSettings.SecretKey en appsettings del VPS .NET.
# Mínimo 16 caracteres. Nunca compartir públicamente.
PAYMENT_JWT_SECRET=

# Issuer y Audience del JWT — deben coincidir con jwtSettings.Issuer / Audience en .NET.
PAYMENT_JWT_ISS=mupga-api
PAYMENT_JWT_AUD=mupga-user

# URL legacy — se puede dejar vacía al activar la nueva integración.
DONATION_URL=

# ── Rankings ─────────────────────────────────────────────────
RANKINGS_LIMIT=25
# Cuentas de admin a ocultar de todos los rankings (separadas por coma).
# Se excluyen por AccountID (memb___id), no por nombre de personaje.
RANKINGS_EXCLUDED_ACCOUNTS=

# ── Cloudflare Turnstile (captcha en registro) ────────────────
# Obtener claves en: https://dash.cloudflare.com → Turnstile
# Dejar vacío para deshabilitar el captcha (dev local).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Reset de personaje ────────────────────────────────────────
RESET_LEVEL_REQUIRED=400
RESET_COST_ZEN=10000000
RESET_STATS=true
RESET_BONUS_POINTS=350
RESET_MAX_RESETS=300

# ── Prode MuPGA ──────────────────────────────────────────────
# Conexión con prode_user (mismo SQL Server, misma DB que DB_HOST/DB_NAME).
# Crear el usuario con database/prode_setup.sql antes de activar el módulo.
PRODE_DB_HOST=localhost\SQLEXPRESS01
PRODE_DB_PORT=
PRODE_DB_NAME=MuOnline
PRODE_DB_USER=prode_user
PRODE_DB_PASS=

# Token para los endpoints de administración del prode (/api/prode/admin_*.php).
# Enviarlo en el header: X-Admin-Token: <valor>
# Generar con: php -r "echo bin2hex(random_bytes(24));"
ADMIN_TOKEN=

# ── ControlPanel / base mupga_admin ──────────────────────────
# Base de datos SEPARADA de la del juego, para contenido del sitio
# (site_status, news, server_info, downloads, admins).
# Login de mínimo privilegio mupga_web_svc:
#   - mupga_admin: db_datareader + db_datawriter (sin DDL).
#   - Base del juego: solo SELECT sobre dbo.vw_web_auth.
# ADMIN_DB_PORT: dejar vacío para que SQL Server Browser resuelva (igual que DB_PORT).
ADMIN_DB_HOST=localhost\SQLEXPRESS01
ADMIN_DB_PORT=
ADMIN_DB_NAME=mupga_admin
ADMIN_DB_USER=mupga_web_svc
ADMIN_DB_PASSWORD=

# ── Tienda WCoin / webshop ─────────────────────────────────────
# Conexión con webshop_user (mismo SQL Server, misma DB que DB_HOST/DB_NAME).
# Login de mínimo privilegio: CONTROL solo sobre el schema webshop, nada
# de CashShopData ni otras tablas del juego. Crear con database/webshop_setup.sql.
WEBSHOP_DB_HOST=localhost\SQLEXPRESS01
WEBSHOP_DB_PORT=
WEBSHOP_DB_NAME=MuOnline
WEBSHOP_DB_USER=webshop_user
WEBSHOP_DB_PASS=

# ── Reclamos (subida de imágenes a Cloudflare R2) ─────────────
# Bucket dedicado "mupga-reclamos". El endpoint es la URL S3 de la cuenta
# de Cloudflare (https://<account_id>.r2.cloudflarestorage.com), se usa
# request path-style (bucket en la ruta, no como subdominio).
# RECLAMOS_R2_PUBLIC_URL es el dominio público de lectura del bucket,
# CON esquema incluido, ej: https://reclamos.mupga.com.ar (dominio custom)
# o https://pub-xxxx.r2.dev (URL r2.dev del bucket). Si te olvidás el
# https://, el código lo agrega solo — pero mejor cargarlo completo.
RECLAMOS_R2_BUCKET=
RECLAMOS_R2_ACCESS_KEY=
RECLAMOS_R2_SECRET_KEY=
RECLAMOS_R2_ENDPOINT=
RECLAMOS_R2_PUBLIC_URL=

# Conexión con mupga_reclamos_svc (mismo SQL Server, base mupga_admin).
# Crear el login/schema con database/reclamos_setup.sql antes de activar el módulo.
RECLAMOS_DB_HOST=localhost\SQLEXPRESS01
RECLAMOS_DB_PORT=
RECLAMOS_DB_NAME=mupga_admin
RECLAMOS_DB_USER=mupga_reclamos_svc
RECLAMOS_DB_PASS=

# Webhook de Discord del canal de reclamos.
DISCORD_WEBHOOK_RECLAMOS=

# Conexión con mupga_forum_svc (mismo SQL Server, base mupga_admin, schema forum).
# Crear el login/schema con database/foro_setup.sql antes de activar el módulo.
# No confundir con FORUM_DB_* de phpBB (esa instalación quedó parqueada sin usar).
FORUM_DB_HOST=localhost\SQLEXPRESS01
FORUM_DB_PORT=
FORUM_DB_NAME=mupga_admin
FORUM_DB_USER=mupga_forum_svc
FORUM_DB_PASS=

# SOLO PARA TESTING: en true desactiva el rate limit de 1 reclamo cada
# 5 minutos por IP. Sacar o poner en false antes de producción.
RECLAMOS_DISABLE_RATE_LIMIT=false

# ── Entorno ───────────────────────────────────────────────────
# development → muestra errores detallados
# production  → errores genéricos
APP_ENV=development
APP_BASE_URL=http://localhost/
